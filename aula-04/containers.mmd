graph TD
    classDef user fill:#1e293b,stroke:#334155,color:#f8fafc;
    classDef system fill:#0369a1,stroke:#0284c7,color:#fff;
    classDef infra fill:#334155,stroke:#475569,color:#fff;

    Admin((Administrador)):::user
    Vendedor((Vendedor)):::user
    Estoque((Gestor de Estoque)):::user

    subgraph Sistema [Sistema de Vendas - API REST]
        API[Rotas HTTP / Endpoints<br>POST, GET, PUT, DELETE]:::system
        Auth[Autenticação JWT]:::system
    end

    DB[(Banco de Dados<br>PostgreSQL)]:::infra

    Admin -- "Gerencia usuários e relatórios<br>Requisições HTTP" --> API
    Vendedor -- "Registra vendas e clientes<br>Requisições HTTP" --> API
    Estoque -- "Atualiza produtos e quantidades<br>Requisições HTTP" --> API

    API --> Auth
    API -- "Lê e grava dados" --> DB

    style Sistema fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#fff
    style DB fill:#090d16,stroke:#475569,stroke-dasharray: 5 5,color:#94a3b8