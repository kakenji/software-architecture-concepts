graph TD
    classDef external fill:#1e293b,stroke:#334155,color:#f8fafc;
    classDef client fill:#0f766e,stroke:#115e59,color:#fff;
    classDef core fill:#0369a1,stroke:#0284c7,color:#fff;
    classDef infra fill:#334155,stroke:#475569,color:#fff;

    subgraph External [Fontes Externas]
        Alta[Paciente Recebe Alta / Hospital]:::external
        Atores[Equipe Médica, Enfermagem e Limpeza]:::external
        IoT[Tags RFID, NFC e QR Code]:::external
    end

    subgraph Interfaces [Interfaces de Acesso]
        Dashboard[Dashboard Web React]:::client
        MobileApp[Aplicativo PWA / Mobile]:::client
    end

    subgraph LetoCore [LETO Backend]
        Gateway[API Gateway / Rotas REST<br>PATCH /beds/:id/status]:::core
        
        subgraph Modules [Módulos de Domínio]
            BedMod[Bed / Room Module<br>Regras do Giro e Status]:::core
            CleaningMod[Cleaning Module<br>Métrica de Tempos]:::core
            IoTAdapter[IoT e Events Adapter<br>Normalização de Payloads]:::core
        end
        
        WSGateway[WebSocket Gateway<br>Tempo Real]:::core
    end

    subgraph Infrastructure [Camada de Persistência]
        DB[(PostgreSQL / Neon<br>Banco de Dados)]:::infra
    end

    %% Fluxo de Alta e Limpeza
    Alta -->|Envia dados de alta POST| Gateway
    IoT -->|Leitura de Tag Inicio/Fim| Gateway
    
    Dashboard -->|Requisições HTTP JWT| Gateway
    MobileApp -->|Requisições HTTP JWT| Gateway
    
    Gateway --> Modules
    IoTAdapter --> BedMod
    BedMod --> CleaningMod

    %% Persistência e Atualização de Status
    BedMod -->|Salva novo status leito| DB
    DB -->|Notifica mudança de estado| WSGateway
    
    WSGateway -->|Push de eventos leaving/cleaning| Dashboard
    WSGateway -->|Push de tarefas de limpeza| MobileApp
    
    Dashboard --> Atores
    MobileApp --> Atores

    style LetoCore fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#fff
    style External fill:#090d16,stroke:#1e293b,stroke-dasharray: 5 5,color:#94a3b8
    style Interfaces fill:#090d16,stroke:#0f766e,stroke-dasharray: 5 5,color:#94a3b8
    style Infrastructure fill:#090d16,stroke:#475569,stroke-dasharray: 5 5,color:#94a3b8